{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:togaf-skills:model:2.0",
  "title": "TOGAF shared project model v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "sources",
    "entities",
    "relationships",
    "views",
    "deliverables",
    "gaps"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "context",
        "is_example"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "domains",
            "landscape",
            "purpose",
            "abstraction",
            "evolution"
          ],
          "properties": {
            "domains": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "business",
                  "data",
                  "application",
                  "technology"
                ]
              }
            },
            "landscape": {
              "enum": [
                "strategic",
                "segment",
                "capability"
              ]
            },
            "purpose": {
              "enum": [
                "strategy",
                "portfolio",
                "project",
                "solution-delivery"
              ]
            },
            "abstraction": {
              "enum": [
                "context",
                "conceptual",
                "logical",
                "physical"
              ]
            },
            "evolution": {
              "enum": [
                "baseline",
                "transition",
                "target"
              ]
            }
          }
        },
        "is_example": {
          "type": "boolean"
        },
        "decision_status": {
          "enum": [
            "candidate",
            "approved",
            "realized"
          ],
          "description": "Deprecated v1 compatibility field. Prefer the independent approval_status and implementation_status fields; migration does not infer either."
        },
        "approval_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "approval_status": {
          "enum": [
            "unknown",
            "candidate",
            "in-review",
            "approved",
            "rejected",
            "withdrawn"
          ],
          "description": "Approval decision, independent of architecture evolution and implementation progress."
        },
        "implementation_status": {
          "enum": [
            "unknown",
            "not-started",
            "in-progress",
            "realized",
            "retired"
          ],
          "description": "Implementation progress. Approval never implies implementation."
        },
        "implementation_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "decision_status"
          ]
        },
        {
          "required": [
            "approval_status",
            "implementation_status"
          ]
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
          },
          "kind": {
            "enum": [
              "user",
              "official",
              "local-translation",
              "figure-interpretation",
              "assumption",
              "example"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string"
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "type",
          "attributes",
          "evidence",
          "certainty"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "certainty": {
            "enum": [
              "confirmed",
              "assumed",
              "uncertain"
            ]
          },
          "concept_id": {
            "type": "string"
          },
          "context": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "domains",
              "landscape",
              "purpose",
              "abstraction",
              "evolution"
            ],
            "properties": {
              "domains": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "business",
                    "data",
                    "application",
                    "technology"
                  ]
                }
              },
              "landscape": {
                "enum": [
                  "strategic",
                  "segment",
                  "capability"
                ]
              },
              "purpose": {
                "enum": [
                  "strategy",
                  "portfolio",
                  "project",
                  "solution-delivery"
                ]
              },
              "abstraction": {
                "enum": [
                  "context",
                  "conceptual",
                  "logical",
                  "physical"
                ]
              },
              "evolution": {
                "enum": [
                  "baseline",
                  "transition",
                  "target"
                ]
              }
            }
          },
          "attributes": {
            "type": "object"
          },
          "evolution": {
            "enum": [
              "baseline",
              "transition",
              "target"
            ]
          },
          "decision_status": {
            "enum": [
              "candidate",
              "approved",
              "realized"
            ],
            "description": "Deprecated v1 compatibility field. Prefer the independent approval_status and implementation_status fields; migration does not infer either."
          },
          "approval_evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "state_id": {
            "type": "string"
          },
          "scope_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "extension_data": {
            "type": "object"
          },
          "measurements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dimension",
                "value",
                "unit",
                "evidence"
              ],
              "properties": {
                "dimension": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": [
                    "number",
                    "string",
                    "null"
                  ]
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "scale_id": {
                  "type": "string",
                  "minLength": 1
                },
                "period": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "uncertainty": {
                  "type": "string"
                },
                "method_evidence": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "calculation_basis": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "approval_status": {
            "enum": [
              "unknown",
              "candidate",
              "in-review",
              "approved",
              "rejected",
              "withdrawn"
            ],
            "description": "Approval decision, independent of architecture evolution and implementation progress."
          },
          "implementation_status": {
            "enum": [
              "unknown",
              "not-started",
              "in-progress",
              "realized",
              "retired"
            ],
            "description": "Implementation progress. Approval never implies implementation."
          },
          "implementation_evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "source",
          "target",
          "label",
          "evidence",
          "certainty"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "certainty": {
            "enum": [
              "confirmed",
              "assumed",
              "uncertain"
            ]
          },
          "codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "attributes": {
            "type": "object"
          },
          "cardinality": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "target"
            ],
            "properties": {
              "source": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "min",
                      "max"
                    ],
                    "properties": {
                      "min": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "max": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0
                      },
                      "unknown": {
                        "const": false
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "unknown"
                    ],
                    "properties": {
                      "unknown": {
                        "const": true
                      },
                      "min": {
                        "type": "null"
                      },
                      "max": {
                        "type": "null"
                      }
                    }
                  }
                ]
              },
              "target": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "min",
                      "max"
                    ],
                    "properties": {
                      "min": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "max": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0
                      },
                      "unknown": {
                        "const": false
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "unknown"
                    ],
                    "properties": {
                      "unknown": {
                        "const": true
                      },
                      "min": {
                        "type": "null"
                      },
                      "max": {
                        "type": "null"
                      }
                    }
                  }
                ]
              }
            },
            "description": "Multiplicity at each endpoint. max:null is unbounded; unknown:true means not established. Bounds such as 1..2 are preserved."
          },
          "state_id": {
            "type": "string"
          },
          "scope_id": {
            "type": "string"
          },
          "extension_data": {
            "type": "object"
          },
          "approval_status": {
            "enum": [
              "unknown",
              "candidate",
              "in-review",
              "approved",
              "rejected",
              "withdrawn"
            ],
            "description": "Approval decision, independent of architecture evolution and implementation progress."
          },
          "implementation_status": {
            "enum": [
              "unknown",
              "not-started",
              "in-progress",
              "realized",
              "retired"
            ],
            "description": "Implementation progress. Approval never implies implementation."
          },
          "implementation_evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "approval_evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "artifact_id",
          "title",
          "context",
          "entity_ids",
          "relationship_ids",
          "analysis",
          "legend"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
          },
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "domains",
              "landscape",
              "purpose",
              "abstraction",
              "evolution"
            ],
            "properties": {
              "domains": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "business",
                    "data",
                    "application",
                    "technology"
                  ]
                }
              },
              "landscape": {
                "enum": [
                  "strategic",
                  "segment",
                  "capability"
                ]
              },
              "purpose": {
                "enum": [
                  "strategy",
                  "portfolio",
                  "project",
                  "solution-delivery"
                ]
              },
              "abstraction": {
                "enum": [
                  "context",
                  "conceptual",
                  "logical",
                  "physical"
                ]
              },
              "evolution": {
                "enum": [
                  "baseline",
                  "transition",
                  "target"
                ]
              }
            }
          },
          "entity_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "relationship_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "analysis": {
            "type": "string",
            "minLength": 1
          },
          "legend": {
            "type": "string",
            "minLength": 1
          },
          "allow_mixed_evolution": {
            "type": "boolean"
          },
          "profile_id": {
            "type": "string",
            "minLength": 1
          },
          "layout": {
            "enum": [
              "reference",
              "adaptive"
            ]
          },
          "template": {
            "type": "object"
          },
          "analysis_results": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "attributes": {
            "type": "object"
          },
          "tailoring": {
            "type": "string"
          },
          "state_id": {
            "type": "string"
          },
          "scope_id": {
            "type": "string"
          },
          "approval_status": {
            "enum": [
              "unknown",
              "candidate",
              "in-review",
              "approved",
              "rejected",
              "withdrawn"
            ],
            "description": "Approval decision, independent of architecture evolution and implementation progress."
          },
          "implementation_status": {
            "enum": [
              "unknown",
              "not-started",
              "in-progress",
              "realized",
              "retired"
            ],
            "description": "Implementation progress. Approval never implies implementation."
          },
          "implementation_evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "approval_evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "state_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "description": "显式选择的命名架构状态；比较视图可选多个状态，顺序为显示与比较顺序。"
          }
        }
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "deliverable_id",
          "title",
          "view_ids",
          "entity_ids",
          "sections"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
          },
          "deliverable_id": {
            "enum": [
              "architecture-building-blocks",
              "architecture-contract",
              "architecture-definition-document",
              "architecture-requirements-specification",
              "architecture-principles",
              "architecture-repository",
              "architecture-roadmaps",
              "architecture-vision",
              "business-goals-objectives",
              "business-principles",
              "business-drivers",
              "capability-assessment",
              "change-request",
              "communications-plan",
              "compliance-assessment",
              "implementation-migration-plan",
              "organization-model",
              "request-for-architecture-work",
              "requirements-impact-assessment",
              "solution-building-blocks",
              "statement-of-work",
              "tailored-architecture-framework"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "view_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "entity_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sections": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "decision_status": {
            "enum": [
              "candidate",
              "approved",
              "realized"
            ],
            "description": "Deprecated v1 compatibility field. Prefer the independent approval_status and implementation_status fields; migration does not infer either."
          },
          "approval_evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "approval_status": {
            "enum": [
              "unknown",
              "candidate",
              "in-review",
              "approved",
              "rejected",
              "withdrawn"
            ],
            "description": "Approval decision, independent of architecture evolution and implementation progress."
          },
          "implementation_status": {
            "enum": [
              "unknown",
              "not-started",
              "in-progress",
              "realized",
              "retired"
            ],
            "description": "Implementation progress. Approval never implies implementation."
          },
          "implementation_evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "assembly": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rules_version",
              "mode"
            ],
            "properties": {
              "rules_version": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "enum": [
                  "strict",
                  "draft"
                ]
              },
              "analysis_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "active_groups": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "scope_id": {
                "type": "string",
                "minLength": 1
              },
              "state_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "section_bindings": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "override": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["reason", "owner", "evidence"],
                      "properties": {
                        "reason": {"type": "string", "minLength": 1},
                        "owner": {"type": "string", "minLength": 1},
                        "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
                      },
                      "description": "Project-specific justified section selector override; does not imply approval or source-defined equivalence."
                    },
                    "view_ids": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "analysis_ids": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "entity_ids": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "tailoring": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "requirement_id",
                    "reason",
                    "owner",
                    "evidence"
                  ],
                  "properties": {
                    "requirement_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "owner": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            },
            "description": "Explicit v2 model-derived section assembly. strict blocks missing inputs; draft retains gaps. Does not imply approval."
          }
        },
        "anyOf": [
          {
            "required": [
              "decision_status"
            ]
          },
          {
            "required": [
              "approval_status",
              "implementation_status"
            ]
          }
        ]
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "impact",
          "needed_input"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
