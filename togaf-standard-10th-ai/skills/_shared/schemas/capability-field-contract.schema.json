{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-togaf:capability-field-contract:1",
  "title": "Project operational field semantics and executable check registration",
  "type": "object",
  "required": ["meaning", "value_rule", "definition_origin", "value_schema"],
  "properties": {
    "meaning": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "value_rule": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "definition_origin": {"enum": ["project-operational-convention", "project-operational-convention-guided-by-cited-source"]},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "value_schema": {"type": "object", "minProperties": 1}
  },
  "additionalProperties": false,
  "$defs": {
    "check": {
      "type": "object",
      "required": ["id", "text", "mode", "source"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "mode": {"enum": ["machine", "manual", "review"]},
        "source": {"enum": ["checks", "semantic_checks", "field-contract", "domain-contract"]},
        "executor": {"type": "string", "minLength": 1},
        "code": {"type": "string", "minLength": 1},
        "applies_to": {
          "type": "object", "required": ["entity_types"], "additionalProperties": false,
          "properties": {"entity_types": {"type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}}}
        }
      },
      "additionalProperties": false,
      "if": {"properties": {"mode": {"const": "machine"}}},
      "then": {"required": ["executor", "code", "applies_to"]},
      "else": {"not": {"anyOf": [{"required": ["executor"]}, {"required": ["code"]}, {"required": ["applies_to"]}]}}
    }
  }
}
