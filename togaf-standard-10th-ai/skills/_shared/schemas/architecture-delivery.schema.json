{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:togaf-skills:architecture-delivery:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "is_example",
    "cycle_id",
    "concerns",
    "phase_work"
  ],
  "properties": {
    "schema_version": {
      "const": "architecture-delivery-1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "is_example": {
      "type": "boolean"
    },
    "cycle_id": {
      "type": "string",
      "minLength": 1
    },
    "concerns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "stakeholder_ids",
          "requirement_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "stakeholder_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "requirement_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "phase_work": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "iteration_id",
          "items"
        ],
        "properties": {
          "phase": {
            "enum": [
              "Preliminary",
              "A",
              "B",
              "C",
              "D",
              "E",
              "F",
              "G",
              "H"
            ]
          },
          "iteration_id": {
            "type": "string",
            "minLength": 1
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "criterion_ids",
                "concern_ids",
                "view_ids",
                "deliverable_ids",
                "method_ids",
                "rationale"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "criterion_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "concern_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "view_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "deliverable_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "method_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "rationale": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
