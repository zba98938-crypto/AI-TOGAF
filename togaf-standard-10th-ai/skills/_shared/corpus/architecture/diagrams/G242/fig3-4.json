  "source_legend_role": "archived-inherited-interpretation-see-current-legend",
  "analysis": {
    "author_purpose_zh": "用一张极简的系统边界图说明：企业 ICT 系统的碳足迹来自技术基础设施（设备、服务器、存储、网络、终端及其建造、运行与报废），而技术基础设施只是为业务流程存储/传输/处理数据、运行应用而存在。它把“架构层”与“碳排放来源”绑定，为随后“在多个层面调整设计”的架构杠杆讨论建立对象模型。",
    "reading_sequence_zh": "先看最外框“ICT System”，它划定核算边界。框内从左到右三个竖框：带人物插画的 Business Processes、Applications and Data、Technical Infrastructures；相邻框之间是粗双向箭头，表示相互调用/支撑。最右侧技术基础设施上方冲出边界的粗黑箭头标着 CO2，表示排放从这一层产生并离开系统。三个圆形编号 1/2/3 与正文三条编号说明一一对应。",
    "source_logic_zh": [
      "ICT系统边界内有业务流程、应用与数据、技术基础设施三个具名框，并有用户终端图示。",
      "业务人物↔终端、终端↔应用数据、应用数据↔基础设施共三支双头箭头。",
      "CO2向上穿出边界，正文将运行、制造、安装、维护、报废以及境外和外包设备纳入技术基础设施碳足迹。",
      "编号1/2/3对应正文论点，不是执行步骤、成熟度或组织层级。"
    ],
    "structure_findings_zh": [
      "本图有 9 个具名或隐含元素、4 条关系和 7 条包含/分组记录。",
      "包含/分组树最大深度为 2；根节点为 ICT 系统、CO2（二氧化碳）。",
      "本图没有可直接确认为人员直属汇报的关系；视觉上下位置、能力分解和治理职责分别读取。"
    ],
    "application_zh": [
      "围绕作者目的读取本图实体、分组与连线，并用对应原文限定其含义。",
      "把参考模型与项目事实分开，实际范围、约束、值和责任须有项目证据。"
    ],
    "hierarchy_explanation_zh": "两层：最外层“ICT System”是系统边界容器；其内三个竖框（Business Processes、Applications and Data、Technical Infrastructures）为并列的组成层，从左到右排列，彼此无父子关系。编号圆点附在对应框上，CO2 箭头附在技术基础设施上并穿出外框。",
    "line_explanation_zh": "两条粗双向箭头（业务流程↔应用与数据、应用与数据↔技术基础设施）表示相邻层之间的相互依赖与调用，不是单向数据流；向上粗箭头表示 CO2 排放离开系统边界，方向由技术基础设施指向外部。外框实线只表示系统边界，不表示连接。",
    "misreadings_zh": [
      "不要把三个竖框读成先后阶段或三个独立系统；它们是同一 ICT 系统的三个层面。",
      "双向箭头不是“数据双向流动”的技术细节，而是层间相互依赖的抽象表示。",
      "CO2 箭头画在技术基础设施上方，不等于只有运行用电产生排放；正文明确还包括建造、安装、维护、报废以及境外制造。",
      "编号 1/2/3 不是阅读顺序，而是与正文三条解释对应的编号；1 在最右、3 在最左。",
      "中文稿当前引用的 figs/g242_fig3-4.svg 是自拟的四层“架构杠杆”清单，增加了原图没有的数据架构层，并丢失 CO2 箭头与系统边界，不能据它理解本图。"
    ],
    "current_findings_zh": [
      "三个编号分别位于技术、应用数据、业务流程；CO2箭头穿出ICT边界。",
      "业务人与应用数据之间画有未命名终端图标，两侧各一支双头箭头，旧解析漏掉终端并合成了直接边。"
    ],
