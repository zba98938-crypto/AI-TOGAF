      "quotes": [
        {
          "text": "The approach to value analysis that is used in Business Architecture is derived from James Martin’s The Great Transition: Using the Seven Disciplines of Enterprise Engineering to Align People, Technology, and Strategy [Martin, 1995]. The value stream (a simple example of which is shown in Figure 1-1) is depicted as an end-to-end collection of value-adding activities that create an overall result for a customer, stakeholder, or end-user. In modeling terms, those value-adding activities are represented by value stream stages, each of which creates and adds incremental stakeholder value from one stage to the next.",
          "source_block_ids": [
            "G178:p0012:b002",
            "G178:p0012:b003",
            "G178:p0012:b004",
            "G178:p0012:b005",
            "G178:p0012:b006",
            "G178:p0012:b007",
            "G178:p0012:b008"
          ]
