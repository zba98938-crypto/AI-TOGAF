  "source_legend_role": "archived-inherited-interpretation-see-current-legend",
  "analysis": {
    "author_purpose_zh": "第 2 章开篇用这张图概览“国际事务与贸易”部门（L1）下的功能（L2）与服务（L3），随后的表 2-1 逐项给出说明。它是 11 个部门图中的第一张，也是图 1-1 三层结构的第一个具体展开；附录 A 第 48 页把它与图 3-1、图 4-1 汇总在同一页。",
    "reading_sequence_zh": "最外层浅蓝色大框是 L1 部门，顶部白色粗体字是部门名称。框内三个等宽的白色圆角框是 L2 功能，从左到右依次为发展与援助、贸易、国际事务。每个功能框里自上而下排列的胶囊形小框是 L3 服务。图中没有连线或箭头，上下级关系完全由框的嵌套表达，同一功能内的服务是并列的。",
    "source_logic_zh": [
      "发展与援助含International Development、Humanitarian Aid；贸易含Global Trade、Export Control、Import Control；国际事务含Foreign Affairs、Foreign Treaties。",
      "表2-1区分发展援助、人道恢复、贸易与进口出口管制、外交贡献与条约/伙伴关系。",
      "服务框的上下排列无优先级或执行先后；本模型的分类不替代特定政府机构的职责授权。"
    ],
    "structure_findings_zh": [
      "本图有 11 个具名或隐含元素、0 条关系和 10 条包含/分组记录。",
      "包含/分组树最大深度为 2；根节点为 国际事务与贸易。",
      "本图没有可直接确认为人员直属汇报的关系；视觉上下位置、能力分解和治理职责分别读取。",
      "原图靠嵌套表达结构，没有连线；新语义图将包含单独显式化，不补造流程、数据流或依赖。"
    ],
    "application_zh": [
      "按父项展开所有直接子项，检查同层粒度、重叠和缺项。",
      "保留组成、分类、能力分解与组织汇报的区别；将示例名称替换为已确认的项目对象。"
    ],
    "hierarchy_explanation_zh": "本图1→3→7的三层参考分类树，真实框包含各自子项；不扩大为现实服务唯一归属的普遍规则。",
    "line_explanation_zh": "图中没有任何连线或箭头。服务框位于功能框内，表示该服务属于该功能；功能框位于部门框内，表示该功能属于本部门（图 1-1 用菱形组合线表示同样的组成关系）。元素清单用 parent/level 记录这种嵌套，因此关系清单为空。",
    "misreadings_zh": [
