  "source_legend": [
    {
      "symbol": "三列并列（Robust Change / Functional Change / Rapid Change）",
      "meaning_zh": "三类变革画像沿横向连续谱排列，左稳健、右快速",
      "explicit": false
    },
    {
      "symbol": "蓝色钟形曲线",
      "meaning_zh": "示意多数变革落在功能画像、向两端递减；无纵轴与刻度",
      "explicit": false
    },
    {
      "symbol": "底部灰色双向粗箭头",
      "meaning_zh": "贯穿三列的连续轴，两端均有箭头且无标签",
