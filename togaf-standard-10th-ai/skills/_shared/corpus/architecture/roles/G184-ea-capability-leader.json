  "role_definition": [
    {
      "text_zh": "负责领导EA能力的建立与演进，Leader表示角色而非固定职位。",
      "evidence": {
        "document_id": "G184",
        "pdf_page": 22,
        "quote_en": "lead the establishment and/or evolution of an EA Capability",
        "source_path": "togaf-standard-10th/G184e.pdf",
        "source_sha256": "85fe5653767b184c3c8c9c1bef9f5738adbb2bf6661fb50ee95e72d16bc9f614",
        "markdown_path": "documents/G184.md#page-22"
      },
      "assertion_type": "source-grounded-analysis"
    }
  ],
  "responsibilities": [
    {
      "text_zh": "区分架构管理和治理职能，并识别胜任人员。",
      "evidence": {
        "document_id": "G184",
        "pdf_page": 68,
        "quote_en": "differentiate the role of these functions and identify qualified personnel",
        "source_path": "togaf-standard-10th/G184e.pdf",
        "source_sha256": "85fe5653767b184c3c8c9c1bef9f5738adbb2bf6661fb50ee95e72d16bc9f614",
        "markdown_path": "documents/G184.md#page-68"
      },
      "assertion_type": "source-grounded-analysis"
    },
    {
      "text_zh": "跟踪参与深度、模型详细程度、产物完成与价值，以验证路线图一致性。",
      "evidence": {
        "document_id": "G184",
        "pdf_page": 108,
        "quote_en": "track the depth of engagement and depth of detail, completion of architecture artifacts, and value",
        "source_path": "togaf-standard-10th/G184e.pdf",
        "source_sha256": "85fe5653767b184c3c8c9c1bef9f5738adbb2bf6661fb50ee95e72d16bc9f614",
        "markdown_path": "documents/G184.md#page-108"
      },
      "assertion_type": "source-grounded-analysis"
    },
    {
      "text_zh": "企业战略未明确时请求最高治理主体定义战略，不代替其拥有战略。",
      "evidence": {
        "document_id": "G184",
        "pdf_page": 33,
        "quote_en": "request the Executive Board, CEO, or the Chairman to define the strategy",
        "source_path": "togaf-standard-10th/G184e.pdf",
        "source_sha256": "85fe5653767b184c3c8c9c1bef9f5738adbb2bf6661fb50ee95e72d16bc9f614",
        "markdown_path": "documents/G184.md#page-33"
      },
      "assertion_type": "source-grounded-analysis"
    }
  ],
  "decision_authority": [],
  "requirements": [
    {
      "text_zh": "能跳出当前运营环境取得更广视角，并贯彻决定领导变更。",
      "evidence": {
        "document_id": "G184",
        "pdf_page": 22,
        "quote_en": "seek broader perspective before making a decision",
        "source_path": "togaf-standard-10th/G184e.pdf",
        "source_sha256": "85fe5653767b184c3c8c9c1bef9f5738adbb2bf6661fb50ee95e72d16bc9f614",
        "markdown_path": "documents/G184.md#page-22"
      },
      "assertion_type": "source-grounded-analysis"
    },
    {
      "text_zh": "理解业务驱动、组织文化、成熟度和相互作用的系统。",
      "evidence": {
        "document_id": "G184",
        "pdf_page": 22,
        "quote_en": "business drivers, organizational culture, and maturity",
        "source_path": "togaf-standard-10th/G184e.pdf",
        "source_sha256": "85fe5653767b184c3c8c9c1bef9f5738adbb2bf6661fb50ee95e72d16bc9f614",
        "markdown_path": "documents/G184.md#page-22"
      },
      "assertion_type": "source-grounded-analysis"
