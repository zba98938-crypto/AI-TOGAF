    ],
    "adm_phases": []
  },
  "semantics": {
    "one_line_zh": "用六块面板围合一个写满 Relations 的立方体，表示业务模型由价值主张、客户、能力等多维要素及其关系构成。",
    "purpose_zh": "介绍 Lindgren 与 Rasmussen 的业务模型立方体，说明业务模型除了清单式框架外，还可以用多维、可组合、可拆看某一面的立体结构来表示，强调「关系」而非单块内容。",
    "reading_guide_zh": "先看中央蓝色立方体：它表面密密麻麻重复印着 Relations，是全图的核心。再看向外拉开的六块面板：顶部品红为 Value Propositions，底部暗红为 Competences，左侧蓝紫为 Activities，左后方橙色为 Customers，右后方绿色为 Network Partners，右侧橙色为 Value Formulas。面板之间没有连线，靠「围绕中心立方体」表达维度与整体的关系。",
    "key_points_zh": [
      "六个维度分别是 Value Propositions、Customers、Network Partners、Activities、Competences、Value Formulas。",
      "中央立方体表面重复写满 Relations，强调六维之间的相互关系才是业务模型的核心，六块面板只是维度本身。",
      "面板被画成「拉开的外壳」，表示可以单独审视某一维度；合拢起来才构成完整立方体。",
      "顶面（价值主张）与底面（能力）相对，左右与后方是活动、客户、网络伙伴、价值公式，位置本身没有严格的层级或顺序。",
      "图中没有任何箭头或流程，也没有客户细分、渠道、成本结构等画布块，不能当作业务模型画布使用。",
      "六种颜色只用于区分面板，图中没有颜色含义说明。"
    ],
    "hierarchy_zh": "两层：中央 Relations 立方体代表「关系」这一核心；六块外围面板代表六个维度，彼此并列，均从属于整个立方体。图中没有上级框，也没有把六维再分解。",
    "line_semantics_zh": "图中没有连线或箭头。六块面板与中央立方体之间只靠空间围绕关系表达「维度围绕关系」；面板之间的相对位置也不表示连线。",
    "misreadings_zh": [
      "不要把中央的 Relations 当成第七个维度：它是模型的核心对象（关系），不是一块面板。",
      "不要把六块面板读成六个步骤或先后顺序，它们同时存在、可任意组合。",
      "不要把面板的上下左右位置当成层级（例如以为 Value Propositions 高于 Competences）。",
      "中文稿第 99 行引用的 SVG 只画了三面，并自拟了“客户/渠道”“资源/伙伴”“成本/收入”，与原图六维名称不符，不能据它理解本图。"
    ],
    "text_evidence": [
      {
        "source": "en_pdf p14",
        "summary_zh": "图 2-3 为业务模型立方体（来源：Lindgren & Rasmussen, 2013）；正文随后说明业务模型画布因 Osterwalder 与 Pigneur 的方法而流行，并成为业务模型创新的基线。"
      },
      {
        "source": "zh_md L95",
