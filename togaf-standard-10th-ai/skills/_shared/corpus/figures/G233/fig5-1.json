  "classification": {
    "diagram_types": [
      "flow"
    ],
    "notation": "ArchiMate 价值流画法：沙色大框为价值流容器，内部左上黄色为业务事件、紫色为利益相关者、白色带 V 形图标的框为价值流阶段（横向排列），右下紫色八边形为成果/价值项",
    "concepts": [
      "value_stream",
      "capability_based_planning"
    ]
  },
  "semantics": {
    "one_line_zh": "一个完整价值流的示例：客户下单触发，经订单处理、拣货、包装、发运四个阶段，交付“一个工作日内发运”的成果。",
    "purpose_zh": "第 5.1.2 节用具体例子说明“价值流阶段”是什么：利益相关者价值很少由单一步骤产生，而是由一串顺序/并行的阶段逐步累加。作者把触发、利益相关者、阶段序列与最终成果放在同一个价值流框内，给读者一个可套用的模板。",
    "reading_guide_zh": "先看沙色大框的标题“Warehouse Order Fulfillment Value Stream”，它界定范围；左上黄框是触发事件（客户下单），其右紫框是接收价值的利益相关者（客户）；中间一排白色 V 形框从左到右是四个阶段；右下紫八边形是价值流成功结束时交付的成果/价值项。全图没有连线，顺序由左右位置表达。",
    "key_points_zh": [
      "价值流由四个阶段组成，顺序为：Customer Order Processing（客户订单处理）→ Pick Ordered Products（拣选所订产品）→ Pack Ordered Products（包装所订产品）→ Ship Ordered Products（发运所订产品）。",
      "触发是一个业务事件“Customer Order Placed（客户下单）”，不是客户本身；Customer（客户）是接收价值的利益相关者，两者在图中分开画。",
      "成果写成可判定的终态“Order shipped within one business day（订单在一个工作日内发运）”，既是价值项也可直接作为最后阶段的退出标准。",
      "价值流是一个整体容器：触发事件、利益相关者、四个阶段与成果都在同一个沙色框内，表示它们属于同一条价值流。",
      "图中只画了阶段名称，没有画每个阶段的描述、进入标准、退出标准；正文说明这些字段在模型中另行记录，图只是结构示意。",
      "图题虽为“Example Value Stream Stage”，实际画的是“一条价值流及其阶段序列”，用于说明单个阶段所处的上下文，而不是某个阶段的字段明细。",
      "阶段框与价值流容器右上角用 V 形（chevron）图标，成果用靶心带箭头图标；这与图 3-1 的 Value Stream/Stage 与 Outcome 记法一致。",
      "正文提醒价值流不一定连续流动，可在任一阶段因未产生所需价值而停止；本图没有画停止/分支路径，只给顺序主线。"
    ],
    "hierarchy_zh": "三层：价值流（沙色容器）→ 4 个价值流阶段（白框，同级并列）；触发事件与利益相关者是价值流的输入/参与要素，成果是价值流的输出，二者都不是阶段的子级。",
    "line_semantics_zh": "图中没有任何连线。阶段先后由从左到右的排列表达；阶段属于该价值流由“位于沙色框内”表达；事件位于起点表示触发整条价值流；成果位于最后阶段下方表示由该价值流产出。这些关系在清单中标为 implicit。",
    "misreadings_zh": [
      "不要把四个阶段读成四个部门或四个应用系统；它们是价值流阶段（增值活动序列）。",
      "不要因为“Customer Order Placed”在 Customer Order Processing 上方，就以为它只触发第一个阶段；正文说业务事件至少触发价值流，也可触发阶段，本图表达的是触发整条价值流。",
      "不要把“Customer”当成执行者；它是接收价值的利益相关者，执行者在该价值流中并未画出。",
      "不要把右下紫色八边形当成第五个阶段；它是成果/价值项（Order shipped within one business day）。",
      "不要把本图当作单个阶段的完整规格；它没有描述、进入/退出标准等字段，只是阶段上下文示意。",
      "中文 PNG 的标题字号比原图小，但阶段名与成果文字完整，不能据此认为标题缺失。"
    ],
    "text_evidence": [
      {
        "source": "en_pdf p30",
        "summary_zh": "利益相关者价值很少由单一步骤产生，通常通过一系列顺序和/或并行的行动——价值流阶段——实现，每个阶段相对前一阶段增量地创造并增加利益相关者价值；见图 5-1。"
      },
      {
        "source": "en_pdf p30",
        "summary_zh": "每个价值流阶段包含名称、描述、进入标准、退出标准与价值项五个要素。"
      },
      {
        "source": "en_pdf p31",
        "summary_zh": "退出标准是表示阶段完成的终态条件，很多情况下阶段名称与退出标准几乎相同；价值项是该阶段创造或交付给参与利益相关者的增量价值；价值流可在任一阶段停止。"
      },
      {
        "source": "zh_md L427",
        "summary_zh": "中文稿说明价值通过一系列顺序和/或并行的价值流阶段实现，每个阶段相对前一阶段增量创造价值，见图 5-1。"
      },
      {
        "source": "zh_md L433",
        "summary_zh": "中文稿给出 8 条图内标签对照：价值流名、触发事件、客户、四个阶段、成果。"
      }
    ]
  },
