  "classification": {
    "diagram_types": [
      "network"
    ],
    "notation": "彩色椭圆节点 + 深青色曲线箭头的组织地图；颜色编码 5 类组织单元（企业/业务单元/部门/外部伙伴/协作团队），右上角 Key 给出图例",
    "concepts": [
      "organization_map",
      "enterprise_context"
    ],
    "adm_phases": []
  },
  "semantics": {
    "one_line_zh": "以企业为中心，用五色椭圆和箭头把业务单元、部门、外部伙伴与协作团队连成一张工作关系网。",
    "purpose_zh": "给出组织地图的“通用模板”：在同一张图里同时容纳企业内部单元、外部伙伴和跨单元协作团队，并用颜色区分组织单元类型，从而直观说明组织地图比组织架构图画得更宽、更深。",
    "reading_guide_zh": "从中央蓝色椭圆 ABC Corporation 读起，它表示地图范围；向外先看绿色业务单元（财务与行政、工程、供应链、市场），再沿箭头看紫色部门、橙色外部伙伴和灰色协作团队。先按颜色判断类型，再按箭头判断工作关系。",
    "key_points_zh": [
      "全图 18 个组织单元、5 种类型：1 个企业、4 个业务单元、4 个部门、6 个外部伙伴、3 个协作团队。",
      "中央企业椭圆表示地图所要覆盖的整体范围，不只是法律实体名称。",
      "4 个业务单元实为职能领域（财务与行政、工程、供应链、市场），说明此处的 business unit 指企业之下的下一层级。",
      "部门（紫色）围绕所属业务单元：HR、设施、财务属财务与行政，仓库属供应链；工程与市场没有紫色部门。",
      "外部伙伴（橙色）贴近对应业务单元：临时用工与工会连 HR，网络供应商连工程，产品供应商连供应链，广告代理商与公共关系机构连市场。",
      "协作团队（灰色）跨单元：董事会连企业，质量保证同时接工程与供应链，产品设计委员会接企业与产品供应商。",
      "箭头是工作关系而非汇报线，方向表示“谁向谁发起/提供”，例如人力资源与设施都指向临时用工。"
    ],
    "hierarchy_zh": "按表 2-1 的类型层级：企业为 L0；业务单元为 L1；部门与外部伙伴同为 L2；协作团队为 L3。图中没有包含框，层级不由嵌套而由颜色和围绕关系表达。",
    "line_semantics_zh": "深青色曲线箭头，无文字标签，表示组织单元之间的工作关系/互动；箭头指出关系的主动方或提供方。箭头不表示汇报，也不表示数据流或价值流。",
    "misreadings_zh": [
      "不要把绿色业务单元当作紫色部门的汇报上级；图只画工作关系，未画汇报线。",
      "橙色是外部伙伴，不是部门；工会、临时用工、广告代理商都在企业法定边界之外。",
      "灰色不是“其他/未分类”，而是跨单元的协作团队。",
      "中央椭圆不是总部，而是整张地图的范围。",
      "中文重绘 SVG 的连线与方向有多处错误（财务部→广告代理商、产品设计委员会→仓库、产品设计委员会→产品供应商等），不能据它读关系。"
    ],
    "text_evidence": [
