  "classification": {
    "diagram_types": [
      "network"
    ],
    "notation": "彩色椭圆节点 + 深青色曲线箭头的组织地图；颜色编码 5 类组织单元，右上角 Key 给出图例",
    "concepts": [
      "organization_map",
      "business_architecture"
    ],
    "adm_phases": []
  },
  "semantics": {
    "one_line_zh": "以全球零售企业为中心，展示三条业务线、五个职能部门、三家门店与三类外部伙伴的关系网。",
    "purpose_zh": "把第 3 章的通用组织地图落到零售企业：用同一套五色记法画出企业、业务线/渠道、职能部门、门店、外部伙伴与协作团队，说明组织地图既能显示组织分工，也能显示运营层面的工作关系。",
    "reading_guide_zh": "从中央蓝色 Global Retail Enterprises, Inc. 开始，先看三条绿色业务线：Central Operations（共享职能）、Retail Operations（门店渠道）、Online Store（线上渠道）；再沿箭头看各业务线连接的紫色部门、橙色外部伙伴和灰色协作团队。",
    "key_points_zh": [
      "全图 17 个组织单元：1 个企业、3 个业务单元、8 个部门、3 个外部伙伴、2 个协作团队。",
      "三条业务线分工不同：中央运营连接最多职能部门，形似共享服务平台；零售运营管门店渠道；在线商店是独立线上渠道。",
      "中央运营连接 HR、财务、IT、产品设计、销售与市场五个部门，是职能部门最集中的一条线。",
      "零售运营管美国、英国、日本三家门店，并与仓库、销售与市场、零售战略团队相连。",
      "在线商店连接 Web 服务与仓库，体现线上渠道对网络服务与履约的依赖。",
      "仓库在此是橙色外部伙伴，不同于图 3-2 中作为紫色部门的仓库；说明同一名称在不同企业可采用不同组织形态。",
      "销售与市场与零售运营之间有一对相反箭头，表示双向工作关系；零售战略团队向销售与市场提供输入。"
    ],
    "hierarchy_zh": "按表 2-1：企业 L0；中央运营、零售运营、在线商店为 L1 业务单元/渠道；HR、财务、IT、产品设计、销售与市场及三家门店为 L2 部门；质量保证、零售战略团队为 L3 协作团队；Web 服务、仓库、产品供应商为 L2 外部伙伴。图中没有包含框，层级由颜色与围绕关系表达。",
    "line_semantics_zh": "深青色曲线箭头，无文字标签，表示组织单元之间的工作关系/互动；方向由箭头指出。箭头不是汇报线，也不是价值流；同一对单元之间可以有两个相反箭头。",
    "misreadings_zh": [
      "绿色业务单元不是紫色部门的汇报上级；箭头只表示工作关系。",
      "仓库是橙色外部伙伴，不是企业内部部门。",
      "中央椭圆不是总部，而是整张地图的范围；“中央运营”才是共享服务业务线。",
      "销售与市场与零售运营之间的两条相反箭头表示双向关系，不是画错。",
      "中文重绘 SVG 只有 16 条箭头（原图 25 条），并有 7 条原图没有的连线，把 Web Services 误译为“网络服务商”，不能据它读关系。"
    ],
