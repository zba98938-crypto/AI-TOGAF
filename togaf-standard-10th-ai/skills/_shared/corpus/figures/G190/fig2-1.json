    ],
    "adm_phases": []
  },
  "semantics": {
    "one_line_zh": "用付款、贷款、客户、账户、分支机构、员工 6 个信息概念及其 7 条带动词的关系，示范金融机构的高层信息地图。",
    "purpose_zh": "第 2 章把信息地图定义为“信息概念及其相互关系的集合”，本图给出一个最小可读的样例：先用“名词质疑”从业务语言中挑出关键名词，再把它们按业务说法连起来。正文同时声明这只是简单高层示例，更细致的建模见附录 A。",
    "reading_guide_zh": "没有固定起点，可从任一概念出发沿箭头读：箭头尾部是句子的主语，箭头指向宾语，线上方/旁的动词短语是关系名。例如 Employee → Branch 旁的 works for 读作“员工为分支机构工作”。先读概念框（蓝色），再读箭头标签，不要给框补充属性和基数。",
    "key_points_zh": [
      "全图只有 6 个概念、7 条关系，全部是业务名词和业务动词，没有属性、主键、基数——这正是信息地图区别于数据模型的地方。",
      "关系用业务语言表达（is made against、requests or receives、holds、provides、manages、supports、works for），没有采用 UML 的关联/组合/泛化等建模记法。",
      "客户是关系的汇聚点：客户“申请或接收”贷款、“持有”账户；贷款与账户又分别被付款、分支机构连接。",
      "付款只连到贷款（is made against），说明付款是针对某笔贷款发生的，而不是直接挂在客户或账户上。",
      "分支机构同时“提供”贷款、“管理”账户；员工“支持”客户、“为”分支机构“工作”，把组织侧的概念也纳入同一张图。",
      "图中有意省略了产品、渠道等概念，属于“简单、高层”示例；正文明确更详细的示例与技术放在附录 A。",
      "方向不可反读：holds 是客户→账户（客户持有账户），works for 是员工→分支机构，反过来会改变业务含义。"
    ],
    "hierarchy_zh": "没有上下级。6 个信息概念平级，图中没有分类、分解或包含关系；层级只体现在概念图整体属于“信息地图”这一制品。",
    "line_semantics_zh": "7 条黑色实线箭头都带动词标签，方向表示业务语句的主语→宾语；没有虚线、没有菱形（组合/聚合）、没有空心三角（泛化）、也没有基数标注。关系是业务词汇层面的关联，不承诺任何实现或数据结构。",
    "misreadings_zh": [
      "不要当成 ER 图或类图：图里没有属性、主键、外键和基数，付款与贷款之间不是数据库的“一对多”。",
      "“持有”是客户→账户，不是账户→客户；中文重绘 SVG 把这条线画成从贷款出发且不接触账户，不能据它理解。",
      "6 个概念之间没有分类层级，贷款不是付款的一种，账户也不是客户的子类。",
      "图中没有出现“产品”，不能据此认为该金融机构没有产品概念——正文说明这是刻意简化的示例。"
    ],
    "text_evidence": [
      {
        "source": "en_pdf p12",
        "summary_zh": "信息地图是信息概念及其相互关系的集合；信息概念反映业务词汇（如客户、账户、产品）；可用“名词质疑”判断某名词是否代表业务需要知道、存储或处理的信息；图 2-1 是金融机构的简单高层示例，更详细的建模语言示例见附录 A。"
      },
      {
        "source": "zh_md L94",
        "summary_zh": "中文稿同样把信息地图定义为“一组信息概念及其相互关系的集合”，并给出客户、账户、产品作为业务词汇的例子。"
      },
      {
        "source": "zh_md L98",
