  "analysis_steps": [
    "锁定测量范围与功能单位并检查清单覆盖",
    "取原始用量、制造因子和云报告",
    "检查期间、单位、生命周期、报告口径与组织归属",
    "选择并声明Scope2口径和分配规则",
    "逐记录计算并检测重复/子集",
    "按相同边界互斥分类汇总毛排放，抵消另列",
    "对齐年度并解释差额、未知量和规则变化",
    "传达业务职能影响及可验证减排杠杆"
  ],
