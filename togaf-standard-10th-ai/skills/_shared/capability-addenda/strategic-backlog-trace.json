  "analysis_methods": [
    {
      "id": "architecture-backlog-trace-review",
      "name": "战略MVA追溯与边界变更评审",
      "owner": "togaf-requirements",
      "source_refs": [
        "G20F §4.5 L304–327",
        "G20F §5.2.3 L529–547",
        "G20F §5.3.2 L601–632"
      ],
      "required_inputs": [
        "原始战略与业务需求",
        "产品负责人明确排序及范围",
        "ABB护栏和SBB候选",
        "依赖及验收证据"
      ],
      "missing_input_policy": "缺关键关系/来源拒绝完成判断；未观察验收返回pending-evidence而非伪造通过",
      "analysis_steps": [
        "逐句提取战略意图、业务分段、故事和原始来源；项目声明epic/feature/story层次，不能假称标准要求",
        "依据产品负责人排序形成MVA必须项边界；保留未纳入项及排除理由",
        "把ABB护栏及计划SBB实现显式关联到故事；核对实现方向和前置依赖",
        "修改战略或边界时保留ID与历史，重算纳入集合与依赖；分别检查验收证据和可运营条件"
      ],
      "output_work_products": [
        "architecture-backlog"
      ],
      "calculator_id": "architecture-backlog-trace-review",
      "example_model": "examples/addenda/backlog-trace/baseline-model.json",
      "method_reference": "references/capability-addenda/architecture-strategic-mva-trace.md"
    }
  ],
