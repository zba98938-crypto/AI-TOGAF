                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      {
                        "type": "object",
                        "minProperties": 1
                      }
                    ]
                  },
                  {
                    "type": "number"
                  }
                ]
              },
              "source_refs": [
                "G203 §2.2–2.3"
              ]
            }
          }
        }
      }
