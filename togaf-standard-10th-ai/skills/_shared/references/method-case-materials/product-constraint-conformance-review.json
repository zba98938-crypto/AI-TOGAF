            "id": "D-TEMP",
            "constraint_ids": [
              "K-RESERVE"
            ],
            "authority": "虚构架构委员会",
            "rationale": "限11月预热批次，隔离执行并核对库存差额",
            "expiry": "2026-11-30",
            "evidence": [
              "DISP"
            ]
          }
        ]
      },
      "expected": {
        "blocked_item_ids": [],
