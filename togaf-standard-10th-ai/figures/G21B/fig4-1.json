      "adm_phase_a"
    ]
  },
  "semantics": {
    "one_line_zh": "把 C-MDM 架构愿景的利益相关者按“外部—运营—高层”三层列出，共 13 个角色/群体。",
    "purpose_zh": "支撑第 4.2 节 ADM 阶段 A（架构愿景）：C-MDM 项目影响整个组织、参与者众多，必须先建立愿景并在高层达成共识；本图给出必须纳入愿景沟通与认可的干系人清单，并暗示越往下越贴近日常运营、越往上越承担赞助与决策。",
    "reading_guide_zh": "从上到下读三条带：最上方“External”是组织外部、只能影响不能指挥的干系人；中间“Operational Management and Team”是日常操作客户数据的人与团队；最下方“High-Level Management and Sponsorship”是提供赞助与跨部门决策的高层。每带左侧的三角形指向右侧，表示该层干系人位于组织边界之内/之外的位置。带内方框并列，从左到右没有顺序或优先级。",
    "key_points_zh": [
      "外部干系人 4 个：客户、监管机构、外部数据提供方、业务伙伴；他们决定 C-MDM 必须满足的体验、合规与数据来源约束。",
      "运营层 4 个：分销商/代理（面向客户、采集客户数据/请求的员工）、C-MDM 运营团队（含 IT、架构师、数据与业务参与者）、客户数据所有者、C-MDM 产品负责人。",
      "高层 5 个：CDO、CTO、人力资源/变革负责人、业务流程所有者，以及横跨整行的 CEO。",
      "CEO 单独占一整行，位于最底部，呼应正文“最佳执行发起人是能打破组织/业务线孤岛的 CEO”。",
      "客户数据所有者与 C-MDM 产品负责人在运营层并列，说明数据问责（owner）与产品交付（product owner）是两条不同的职责线。",
      "CDO 与 CTO 在高层并列：C-MDM 同时是数据治理议题与技术架构议题；HR/变革负责人负责组织变革与采纳。",
      "图只给干系人分层，不画影响力方向或沟通关系；具体愿景维度（FROM/TO/关键举措）见表 4-2。"
    ],
    "hierarchy_zh": "三层：外部（组织外）→ 运营管理与团队（执行层）→ 高层管理与赞助（决策/赞助层）。每层内的方框并列，无上下级；CEO 虽在最底层带内，但横贯整行，视觉上表示其对全部利益相关者的最终发起作用。",
    "line_semantics_zh": "图中没有连接线。三条水平虚线只分隔层级；左侧的向右三角形是层级标记（不是箭头关系），不表示数据或影响力流向。干系人之间的关系完全由“在哪一带”表达（关系清单中标为隐含）。",
    "misreadings_zh": [
      "不要把三条带读成汇报层级：外部干系人不在组织内，运营层与高层也不是严格的上下级，只是按“离日常运营的远近”分组。",
      "CEO 画在最底部不代表其层级最低；它横跨整行，表示对全部干系人的最终赞助与破孤岛作用。",
      "图中没有画出干系人之间的沟通线，不能据此判断谁向谁汇报。",
      "中文稿本地化图有两个运营框边框断裂、一个标签字号过小，容易让人以为该框不属于本层；原图中它们都是完整框。"
    ],
    "text_evidence": [
      {
        "source": "en_pdf p30",
        "summary_zh": "图 4-1 列出架构愿景的利益相关者；正文强调 C-MDM 方法必须有横向愿景，最佳执行发起人是能打破组织/业务线孤岛、为客户谋利益的 CEO。"
      },
      {
        "source": "en_pdf p29",
        "summary_zh": "愿景应涵盖关键 C-MDM 利益相关者，如图 4-1 所示。"
      },
      {
        "source": "zh_md L317",
        "summary_zh": "C-MDM 项目复杂、影响整个实体、涉及众多参与者，必须首先建立愿景并在高层与所有相关利益相关者达成共识，且由执行发起人和/或 CEO 认可。"
      },
      {
        "source": "zh_md L328",
        "summary_zh": "该愿景应涵盖关键 C-MDM 利益相关者（原文 Figure 4-1：架构愿景的利益相关者）。"
      }
    ]
  },
