  "semantics": {
    "one_line_zh": "组织客户内核数据六类：内部/外部标识键、法人描述、联系方式、偏好/同意、关系/集团成员。",
    "purpose_zh": "界定 C-MDM 对“组织”（法人实体）客户应管理的核心数据范围，与图 5-1 的自然人范围并列；说明同一套 C-MDM 要同时容纳 B2C 与 B2B 两类客户，且法人数据需要额外的官方注册标识与规模/业务领域描述。",
    "reading_guide_zh": "先确认标题是“Customer Data – Organization”，再与图 5-1 对照读：上排仍是内部标识键、外部标识键，但第三格换成“法人描述”；下排是联系方式、偏好/同意、关系/集团成员。六个框并列，无先后；字段级内容见表 5-2。",
    "key_points_zh": [
      "组织客户同样有内部标识键（业务客户编码、唯一技术键）与外部标识键（组织官方编号、数据提供方参考号、国家登记 ID 等）。",
      "法人描述包含组织名称、替代名称（经营名称）、成立日期、规模参数（dimensioning data，如官方权重类别）与组织业务领域；中文稿表 5-2 特别标注英文原文仍沿用“First name”“Date of birth”等自然人字段名。",
      "联系方式数据包括相关自然人及其联系方式（可链接到 C-MDM 中的另一自然人）、相关地址与相关电子邮箱。",
      "偏好/同意数据与自然人相同，记录组织授权/不授权使用某范围数据。",
      "关系/集团成员描述组织与其他实体的关系（如母公司、子公司、集团成员），对应自然人图中的“与其他客户的关系”。",
      "图 5-2 与图 5-1 结构完全同构，差别只在第三格（法人描述 vs 个人标识数据）与第六格（关系/集团成员 vs 与其他客户的关系）。"
    ],
    "hierarchy_zh": "两层：第 1 层是“组织客户内核数据”；第 2 层是六个并列分类。分类之间无上下级、无连线。",
    "line_semantics_zh": "图中没有连线或箭头；六个分类的并列与同属关系只由 2×3 网格与淡黄底板表达。",
    "misreadings_zh": [
      "不要把“法人描述”当作一个字段：它是名称、替代名称、成立日期、规模参数、业务领域等一组属性的分类。",
      "英文原图表 5-2 中仍出现“First name”“Date of birth”字样，是原文沿用自然人模板的措辞，实际含义是组织名称与成立日期（中文稿已注明）。",
      "组织客户的“关系/集团成员”不是人际父子关系，而是法人之间的集团/股权/成员关系。",
      "图只给分类，不给字段；设计数据模型须结合表 5-2。"
    ],
    "text_evidence": [
      {
        "source": "en_pdf p39",
        "summary_zh": "组织多数是依国家规定在主管机关登记的法人实体，可以是公司、行政机构、NGO 等；图 5-2 给出组织/法人内核数据的分类，表 5-2 逐项说明。"
      },
      {
        "source": "zh_md L483",
        "summary_zh": "组织多数情况下是依所在国家规定在主管机关登记的法人实体，可以是公司、行政机构、非政府组织（NGO）等。"
      },
      {
        "source": "zh_md L485",
