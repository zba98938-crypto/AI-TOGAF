  "classification": {
    "diagram_types": [
      "hierarchy"
    ],
    "notation": "ArchiMate 嵌套功能图：蓝色应用功能大组内嵌 6 个功能组框，每个组框内为带功能记号的二级应用功能框；无连线",
    "concepts": [
      "metadata_management",
