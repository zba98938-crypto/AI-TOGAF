      "application_architecture"
    ],
    "adm_phases": []
  },
  "semantics": {
    "one_line_zh": "把 6 项高层应用功能展开为 24 项二级应用功能，形成元数据管理 IT 方案的功能清单。",
    "purpose_zh": "第 5.2 节的应用参考模型，用于 ADM 阶段 C/E：阶段 C 拿它做应用功能差距分析，阶段 E 拿它逐项挑战解决方案供应商的功能覆盖。",
    "reading_guide_zh": "从蓝色大组 Metadata Management Application Functions 进入，按 6 个组读：Acquisition（采集）、Governance（治理）、Reporting（报表）、Reference Data Management（参考数据管理）、Metadata Integration（元数据集成）、Administration（管理）。组框标题是一级应用功能，组内小框是二级功能；没有连线，嵌套表示归属。",
    "key_points_zh": [
      "采集组 5 项：元数据创建/修订/删除、元数据分类、元数据关联、元数据推断、数据质量规则执行；覆盖元数据的产生与加工。",
      "治理组 4 项：工作流校验、影响分析、任务分配、元数据活动监控；对应治理所需的审批、影响评估与运行监控。",
      "报表组 5 项：数据合规报表、数据文档报表、数据问责报表、数据质量报表、元数据搜索；既面向监管也面向日常使用。",
      "参考数据管理组只有 1 项：值列表管理（类别列表、代码列表等），说明它是独立但范围集中的能力。",
      "元数据集成组 4 项：元数据查询、批量导入、批量导出、事件订阅；纯技术性交换能力，与图 4-9 的三种模式对应。",
      "管理组 5 项：环境管理、访问管理、国际化与本地化、事件日志管理、数据库版本管理；是支撑前三类能力的运行底座。"
    ],
    "hierarchy_zh": "两层：应用功能大组（L1）→ 6 个一级功能组（L2）→ 24 个二级应用功能（L3）。组与组并列，无跨组连线。",
    "line_semantics_zh": "全图无连线；嵌套与框的位置表示“二级功能属于该组”，组框的排列次序不表示调用顺序。",
    "misreadings_zh": [
      "不要把 Acquisition 只理解为“采集工具”；它还包含创建、修订、删除、分类、关联与推断。",
      "不要把 Metadata Integration 当成跨组连接线；它是与其他组并列的一组应用功能。",
      "不要以为 Reference Data Management 与 Reporting 有从属关系；它们是并列组。",
      "中文 PNG 中部分二级功能字号极小，不能因看不清而认为原图没有这些功能。"
    ],
