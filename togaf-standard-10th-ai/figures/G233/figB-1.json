    ]
  },
  "semantics": {
    "one_line_zh": "波特的价值链：四项支持活动横贯上方，五项主要活动横向排列，右侧灰色箭头表示扣除全部活动成本后剩下的利润（Margin）。",
    "purpose_zh": "附录 B.5 用价值链说明另一种价值视角：价值链把企业拆成战略相关活动，以理解成本行为与差异化来源；它提供“企业如何生产经济价值（金钱）”的宏观视图，可作为决定“需要建模哪些价值流来保证价值链运转”的依据。作者把它与价值流对照，说明两者目的相近但切分方式不同。",
    "reading_guide_zh": "先看两条花括号：左侧“Support Activities”覆盖上方四行，底部“Primary Activities”覆盖下方五列。主要活动从左到右读：Inbound Logistics → Operations → Outbound Logistics → Marketing And Sales → Service。支持活动自上而下读：Firm Infrastructure、Human Resource Management、Technology Development、Procurement，它们横贯并支撑所有主要活动。最右侧灰色大箭头“Margin”从顶到底包住整条链，表示总价值减去总成本后的剩余。",
    "key_points_zh": [
      "五项主要活动：入站物流、运营、出站物流、市场营销与销售、服务；它们直接创造并交付产品/服务。",
      "四项支持活动：企业基础设施、人力资源管理、技术开发、采购；它们不直接面向客户，但为所有主要活动提供支撑。",
      "Margin（利润）不是一项活动，而是整条链的剩余价值：总收入减去全部主要活动与支持活动的成本。图中用一条从顶贯到底的灰色箭头表示它包住整条链。",
      "支持活动画成横贯四行，表示它们服务于所有主要活动，而不是只在某一列发生。",
      "价值链以成本与利润为中心，给出经济价值的宏观视图；价值流以利益相关者价值为中心，给出端到端活动序列。两者粒度与目的不同。",
      "正文建议：价值链可作为决定“需要建模哪些价值流”的依据——先看价值链哪些环节重要，再为这些环节建价值流模型。",
      "价值链通常对整个组织或业务单元建模，与商业模式画布的粒度相近。",
      "本图与 G178《价值流》附录 A 的图 A-1 是同一张图（同一来源、同一版式）。"
    ],
    "hierarchy_zh": "两层：两类活动（支持活动、主要活动）→ 各自包含的活动项。支持活动与主要活动是并列的两组，不是上下级；Margin 是覆盖全图的结果，不属于任何一组。",
    "line_semantics_zh": "图中没有连线。分组由花括号表达；Margin 的涵盖范围由灰色箭头的跨度表达（从支持活动顶端到主要活动底端）；主要活动的先后由从左到右的排列暗示，但价值链本身不强调时间顺序。",
    "misreadings_zh": [
      "不要把 Margin 当成第六项主要活动；它是剩余价值，不是活动。",
      "不要把四项支持活动理解为按时间先后发生；它们是横贯的支撑职能。",
      "不要把主要活动的左右排列当成严格流程；波特价值链是活动分类，不是价值流阶段。",
      "不要把本图与价值流图混用：价值链回答“钱如何被创造”，价值流回答“利益相关者价值如何被交付”。",
      "中文稿 PNG 的“利润”方块过大并遮住右上角，且下方旋转的 Margin 未译；不要据其判断 Margin 的图形范围。"
    ],
    "text_evidence": [
      {
        "source": "en_pdf p52",
        "summary_zh": "价值链由 Michael Porter 在《竞争优势：创造并维持卓越绩效》中提出；它把企业分解为战略相关活动，以理解成本行为与现有差异化来源。"
      },
      {
        "source": "en_pdf p52",
        "summary_zh": "价值链以活动成本与利润为主要关注点，关注经济价值如何被创造；它提供企业生产经济价值的宏观视图，通常对整个组织或业务单元建模，可作为决定需要建模哪些价值流的依据。"
      },
      {
        "source": "zh_md L891",
        "summary_zh": "中文稿说明价值链由波特提出，把企业分解为若干战略相关活动，以理解成本行为及差异化潜在来源。"
      },
      {
        "source": "zh_md L899",
