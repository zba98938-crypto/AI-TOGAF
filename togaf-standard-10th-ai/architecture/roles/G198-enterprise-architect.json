  "role_definition": [
    {
      "text_zh": "确保架构完整性、适用性与视图整合，协调利益相关者冲突并呈现权衡。",
      "evidence": {
        "document_id": "G198",
        "pdf_page": 20,
        "quote_en": "completeness (fitness-for-purpose)",
        "source_path": "togaf-standard-10th/G198e.pdf",
        "source_sha256": "d5c636f7a991605dccfd7e81374261426af82c12cf918b128d3bd7ed4b3edb65",
        "markdown_path": "documents/G198.md#page-20"
      },
      "assertion_type": "source-grounded-analysis"
    }
  ],
  "responsibilities": [
    {
      "text_zh": "理解并解释需求，区分真实需要与愿望，形成可行动要求。",
      "evidence": {
        "document_id": "G198",
        "pdf_page": 21,
        "quote_en": "Understand and interpret requirements",
        "source_path": "togaf-standard-10th/G198e.pdf",
        "source_sha256": "d5c636f7a991605dccfd7e81374261426af82c12cf918b128d3bd7ed4b3edb65",
        "markdown_path": "documents/G198.md#page-21"
      },
      "assertion_type": "source-grounded-analysis"
    },
    {
      "text_zh": "创建可沟通的多视图模型，保持整体架构完整性并发现构建块复用。",
      "evidence": {
        "document_id": "G198",
        "pdf_page": 21,
        "quote_en": "Create a useful model",
        "source_path": "togaf-standard-10th/G198e.pdf",
        "source_sha256": "d5c636f7a991605dccfd7e81374261426af82c12cf918b128d3bd7ed4b3edb65",
        "markdown_path": "documents/G198.md#page-21"
      },
      "assertion_type": "source-grounded-analysis"
    },
    {
      "text_zh": "验证假设，纳入领域专家，细化扩展模型。",
      "evidence": {
        "document_id": "G198",
        "pdf_page": 22,
        "quote_en": "Validate, refine, and expand the model",
        "source_path": "togaf-standard-10th/G198e.pdf",
        "source_sha256": "d5c636f7a991605dccfd7e81374261426af82c12cf918b128d3bd7ed4b3edb65",
        "markdown_path": "documents/G198.md#page-22"
      },
      "assertion_type": "source-grounded-analysis"
    },
    {
      "text_zh": "持续维护架构模型，在开发与决策节点表达架构问题。",
      "evidence": {
        "document_id": "G198",
        "pdf_page": 22,
        "quote_en": "Manage the architecture",
        "source_path": "togaf-standard-10th/G198e.pdf",
        "source_sha256": "d5c636f7a991605dccfd7e81374261426af82c12cf918b128d3bd7ed4b3edb65",
        "markdown_path": "documents/G198.md#page-22"
      },
      "assertion_type": "source-grounded-analysis"
    }
  ],
  "decision_authority": [
    {
      "text_zh": "选择适用的架构视图，受可行性与适用性约束。",
      "evidence": {
        "document_id": "G198",
        "pdf_page": 20,
        "quote_en": "choice of which particular architecture views to develop",
        "source_path": "togaf-standard-10th/G198e.pdf",
        "source_sha256": "d5c636f7a991605dccfd7e81374261426af82c12cf918b128d3bd7ed4b3edb65",
        "markdown_path": "documents/G198.md#page-20"
      },
      "assertion_type": "source-grounded-analysis"
    }
  ],
  "requirements": [
    {
      "text_zh": "复杂系统设计能力：需求发现、上下文、方案替代与评价、技术选择、配置。",
      "evidence": {
        "document_id": "G198",
        "pdf_page": 24,
        "quote_en": "requirements discovery and analysis",
        "source_path": "togaf-standard-10th/G198e.pdf",
        "source_sha256": "d5c636f7a991605dccfd7e81374261426af82c12cf918b128d3bd7ed4b3edb65",
        "markdown_path": "documents/G198.md#page-24"
      },
      "assertion_type": "source-grounded-analysis"
    },
    {
      "text_zh": "具备广泛技术经验，并至少在一个领域达到专家深度。",
      "evidence": {
        "document_id": "G198",
        "pdf_page": 24,
        "quote_en": "extensive technical breadth",
        "source_path": "togaf-standard-10th/G198e.pdf",
        "source_sha256": "d5c636f7a991605dccfd7e81374261426af82c12cf918b128d3bd7ed4b3edb65",
        "markdown_path": "documents/G198.md#page-24"
      },
      "assertion_type": "source-grounded-analysis"
    },
    {
      "text_zh": "掌握多个设计方法并有重复成功运用记录，能按情境裁剪。",
      "evidence": {
        "document_id": "G198",
        "pdf_page": 25,
        "quote_en": "working knowledge of more than one design method",
        "source_path": "togaf-standard-10th/G198e.pdf",
        "source_sha256": "d5c636f7a991605dccfd7e81374261426af82c12cf918b128d3bd7ed4b3edb65",
        "markdown_path": "documents/G198.md#page-25"
      },
      "assertion_type": "source-grounded-analysis"
    },
    {
      "text_zh": "经历设计、开发、测试、实施与生产整个项目范围。",
      "evidence": {
        "document_id": "G198",
        "pdf_page": 25,
        "quote_en": "all aspects of a project",
        "source_path": "togaf-standard-10th/G198e.pdf",
        "source_sha256": "d5c636f7a991605dccfd7e81374261426af82c12cf918b128d3bd7ed4b3edb65",
        "markdown_path": "documents/G198.md#page-25"
      },
      "assertion_type": "source-grounded-analysis"
    },
    {
      "text_zh": "具备沟通、团队建设与领导力。",
      "evidence": {
        "document_id": "G198",
        "pdf_page": 25,
        "quote_en": "Communication and team building",
        "source_path": "togaf-standard-10th/G198e.pdf",
        "source_sha256": "d5c636f7a991605dccfd7e81374261426af82c12cf918b128d3bd7ed4b3edb65",
        "markdown_path": "documents/G198.md#page-25"
      },
      "assertion_type": "source-grounded-analysis"
    },
    {
      "text_zh": "具备沟通复杂信息、谈判和解决问题的能力，并及时与项目管理团队决策。",
      "evidence": {
        "document_id": "G198",
        "pdf_page": 25,
        "quote_en": "Strong negotiation and problem-",
        "source_path": "togaf-standard-10th/G198e.pdf",
        "source_sha256": "d5c636f7a991605dccfd7e81374261426af82c12cf918b128d3bd7ed4b3edb65",
        "markdown_path": "documents/G198.md#page-25"
      },
      "assertion_type": "source-grounded-analysis"
    },
    {
      "text_zh": "具备行业经验，理解业务流程、行业协作与关键趋势。",
      "evidence": {
        "document_id": "G198",
        "pdf_page": 25,
        "quote_en": "Industry skill and experience",
        "source_path": "togaf-standard-10th/G198e.pdf",
        "source_sha256": "d5c636f7a991605dccfd7e81374261426af82c12cf918b128d3bd7ed4b3edb65",
        "markdown_path": "documents/G198.md#page-25"
      },
      "assertion_type": "source-grounded-analysis"
    }
  ],
  "inputs_outputs": [
